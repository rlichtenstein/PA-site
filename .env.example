# Postgres connection string (Vercel Postgres, Neon, Supabase, etc all work)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Gate for /admin pages and /api/admin/* endpoints (HTTP Basic Auth)
ADMIN_USER=pa-admin
ADMIN_PASSWORD=change-me

# Resend (https://resend.com) API key for sending confirmation/reminder emails.
# Leave unset in local dev to just log emails to the console instead of sending.
RESEND_API_KEY=
EMAIL_FROM="Cathedral School PA <pa@yourdomain.org>"

# Public base URL, used to build cancellation links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob storage token, for receipt uploads on the reimbursement form.
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=

# Shared secret checked on the /api/cron/reminders endpoint so only
# Vercel Cron (or you, manually) can trigger reminder emails.
CRON_SECRET=change-me-too
